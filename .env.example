# 必填；複製為 .env 後填寫。所有 token 與金鑰不得提交至 Git。
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
BOT_TRIGGER_NAME=小石
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=sitcon-tw/editorial/board
GITLAB_TOKEN=

# 本機路徑；Compose 會覆寫成 /run/secrets/google-sa.json。
# 直接使用 service account，沒有 Domain-Wide Delegation。
GOOGLE_SA_JSON_PATH=secrets/google-sa.json
ROSTER_SHEET_ID=1GD4VOSN8UIL4TAo1tBVVt-SPdMXQs6y28XUcxN6_xrE
ROSTER_SHEET_GID=0
DRIVE_ROOT_FOLDER_ID=1rMkuh-qNk_GcADbZItTh8cM9MhwBJsi6
DOC_TEMPLATE_ID=1ISur15UxlnXVi0vB4zBVqhby2YNGGIViccZI0IiL-LU

# 主模型：DeepSeek 經 Cloudflare AI Gateway（OpenAI 相容 Chat Completions）。
# LLM_API_KEY 填 Cloudflare token；base URL 不含 /chat/completions。
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-flash
LLM_BASE_URL=https://cf-ai.yuan-tw.net/compat
# openai_compat 一律使用 Bearer；此開關只影響 Anthropic adapter。
LLM_AUTH_BEARER=true
LLM_SERVICE_TIER=
LLM_THINKING=off
LLM_WEB_SEARCH=false
LLM_MAX_TOOL_ITERATIONS=12

# 網路搜尋使用獨立 Anthropic 相容服務。
WEB_SEARCH_API_KEY=
WEB_SEARCH_MODEL=claude-opus-4-8
WEB_SEARCH_BASE_URL=
WEB_SEARCH_AUTH_BEARER=false
WEB_SEARCH_MAX_USES=0
WEB_SEARCH_MAX_CONTENT_TOKENS=40000
WEB_SEARCH_COUNTRY=TW
WEB_SEARCH_TIMEOUT=180

DB_PATH=data/editorial.sqlite3
MIGRATIONS_PATH=migrations
TZ=Asia/Taipei
CACHE_TTL_ROSTER=300
CACHE_TTL_WIKI=900
CONTEXT_TTL_SECONDS=1800
MAX_CONCURRENT_AGENT_TURNS=4
DEFAULT_DOCUMENT_LABEL=社群文案
DEFAULT_TASK_LABEL=編輯組專案
INITIAL_STATUS=Status::Inbox
REVIEW_STATUS=Status::Review
LOG_LEVEL=INFO
